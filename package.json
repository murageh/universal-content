{
  "name": "@crispice/universal-content",
  "version": "0.1.0",
  "description": "Universal content engine for Next.js, Fastify, and Vite: Markdown + Headless WordPress with two-tier caching",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js",
      "require": "./dist/fastify.cjs"
    },
    "./wordpress": {
      "types": "./dist/wordpress.d.ts",
      "import": "./dist/wordpress.js",
      "require": "./dist/wordpress.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./vite": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "import": "./dist/seo.js",
      "require": "./dist/seo.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/build-docs.ts",
    "build:docs": "tsx scripts/build-docs.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "markdown",
    "content",
    "gray-matter",
    "remark",
    "fastify",
    "wordpress",
    "wpgraphql",
    "static-site"
  ],
  "author": "MURAGEH (murageh.co.ke)",
  "license": "MIT",
  "peerDependencies": {
    "ioredis": ">=5.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "fastify-plugin": "^6.0.1",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
