# ==============================================================================
# Universal SEO & Content Playground Environment Configuration
# Target Deployment: https://playground.murageh.co.ke
# ==============================================================================

# Fastify Server Network Binding
PORT=3001
HOST=0.0.0.0

# Base Domain for Canonical URLs, OpenGraph Cards, and Sitemaps
ROOT_DOMAIN=murageh.co.ke

# Optional L2 Redis Cache Connection URI
# Leave unset/commented out to use the built-in high-speed in-memory L1 LRU cache.
# When provided, sitemap chunks and parsed articles are shared across replicas.
# REDIS_URL=redis://default:password@127.0.0.1:6379
